      <column caption='Category Title' datatype='string' name='[Calculation_1083960198707421184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Category]=[Parameters].[Parameter 1]&#13;&#10;THEN [Category] + &quot; ▲&quot;&#13;&#10;ELSE [Category] + &quot; ▼&quot;&#13;&#10;END' />
      </column>
      <column caption='Region*:Sortkey' datatype='string' name='[Calculation_1083960198707912705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Region]=[Parameters].[Parameter 2]&#13;&#10;THEN [Region]+&quot;*&quot;&#13;&#10;ELSE [Region]&#13;&#10;END' />
      </column>
      <column caption='Sub-Category Breakdown' datatype='string' name='[Calculation_1083960198708109314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Category]=[Parameters].[Parameter 1]&#13;&#10;THEN [Sub-Category]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Product Name (Cat,SubCat)' datatype='string' name='[Calculation_1083960198708879363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Product Name]+&quot; (&quot;+[Category]+&quot;,&quot;+[Sub-Category]+&quot;)&quot;' />
      </column>
      <column caption='Profit Ratio' datatype='real' default-format='*0%;&quot;▲&quot;0%' name='[Calculation_1083960198709112836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Profit])&#13;&#10;/&#13;&#10;sum([Sales])' />
      </column>
      <column caption='High Light Dummy' datatype='string' name='[Calculation_1083960198709497861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Dummy&quot;' />
      </column>
      <column caption='Product-Category-Region' datatype='string' name='[Calculation_1083960198710403078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Product Name]+[Category]+[Region]' />
      </column>
      <column caption='HighLight False' datatype='boolean' name='[Calculation_1083960198713409543]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='FALSE' />
      </column>
      <column caption='Product Name Sort Key' datatype='real' name='[Calculation_1083960198727815191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Product Name],[Category],[Sub-Category]:sum(&#13;&#10;    IF [Region]=[Parameters].[Parameter 2] THEN [Profit] END&#13;&#10;)}&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;{fixed [Product Name],[Category],[Sub-Category]:sum(&#13;&#10;    IF [Region]=[Parameters].[Parameter 2] THEN [Sales] END&#13;&#10;)}' />
      </column>
