              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09f4ze80oodskj15ely2b0prw7l1'>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_1439181618232954887]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_1439181618233090056]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] -1' />
            </column>
            <column caption='CY Customers' datatype='string' name='[Calculation_1439181618470015027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Parameter 1] then  [Customer ID]&#13;&#10;END' />
            </column>
            <column caption='PY Customers' datatype='string' name='[Calculation_1439181618470744116]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date]) = [Parameters].[Parameter 1] - 1 THEN [Customer ID]&#13;&#10;END' />
            </column>
            <column caption='% Diff Customers' datatype='real' name='[Calculation_1439181618470932533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_1439181618470015027])-COUNTD([Calculation_1439181618470744116]))/COUNTD([Calculation_1439181618470744116])' />
